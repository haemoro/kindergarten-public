# Supabase Database Configuration
# Get these values from your Supabase project settings > Database
SUPABASE_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-database-password

# Kindergarten API (e-childschoolinfo.moe.go.kr)
KINDERGARTEN_API_KEY=your-api-key

# === Docker Production Settings ===
# JDBC URL (for production profile)
SUPABASE_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# JWT Secret (change in production!)
JWT_SECRET=kindergarten-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256

# Naver Search API (https://developers.naver.com/apps)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
